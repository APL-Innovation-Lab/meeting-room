# Environment contract for the APL Meeting Room prototype.
#
# This file is the single source of truth for the environment variables the app
# needs. It is committed and safe to read: it contains the SCHEMA only, never
# secret values. Real values go in .env (gitignored). See CONTRIBUTING.md.
#
# Varlock validates the resolved env at dev/build time (via the Vite plugin) and
# generates types into env.d.ts. A missing/invalid var fails loudly here instead
# of silently breaking the app at runtime.
#
# @generateTypes(lang=ts, path=./env.d.ts)
# @defaultRequired=true
# @defaultSensitive=false
# ---

# Mapbox GL JS access token — a PUBLIC token (the `pk.*` kind).
#
# This is NOT a server secret. mapbox-gl runs in the browser, so this value ships
# inside the client bundle and is visible to anyone who loads the deployed app.
# That is unavoidable and by design — do NOT mark it @sensitive, which would strip
# it from the client bundle and break the map.
#
# Protect it the way Mapbox intends, in the Mapbox dashboard, NOT by hiding the
# string: restrict the token to your allowed URLs (include http://localhost:5173
# for local dev) and grant it only public scopes. For local dev, generating your
# own free token is simplest: https://docs.mapbox.com/api/accounts/tokens
#
# @required
# @type=string
VITE_APP_MAPBOX_TOKEN=

# Where the app's persistence lives, as a libSQL URL. Accepted shapes:
#   file:data/apl.db       — local SQLite file (the dev default when unset)
#   http(s)://host[:port]  — remote libSQL server (sqld), e.g. Railway private networking
#   libsql://host          — remote libSQL server over its native protocol
#
# On Railway, point this at the libSQL Server service's private URL
# (e.g. http://<service>.railway.internal:8080) so the app stays stateless and
# redeploys never touch data. Read by the app at runtime (db/client.server.ts)
# and by drizzle-kit push/studio (drizzle.config.ts).
#
# @required=false
# @type=string
APL_DB_URL=

# Auth token for a remote libSQL server (sqld's SQLD_HTTP_AUTH / SQLD_AUTH_JWT_KEY
# setup). Leave empty for the local dev file or an unauthenticated server that is
# only reachable over Railway's private network.
#
# @required=false
# @sensitive
# @type=string
APL_DB_AUTH_TOKEN=
