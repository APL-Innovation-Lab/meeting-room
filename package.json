{
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "vite dev --host",
        "format": "prettier -w .",
        "lint": "eslint --fix --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
        "typecheck": "react-router typegen && tsc",
        "test": "npm run test:run",
        "test:dev": "vitest dev",
        "test:run": "vitest run",
        "build": "vite build",
        "start": "react-router-serve ./build/server/index.js",
        "styles:compile-components": "tsx tailwindcss-uswds/build/compile-components.ts",
        "styles:generate-theme": "tsx tailwindcss-uswds/build/generate-theme.ts"
    },
    "dependencies": {
        "@deno/kv": "^0.13.0",
        "@react-router/fs-routes": "^7.13.0",
        "@react-router/node": "^7.13.0",
        "@react-router/serve": "^7.13.0",
        "@std/async": "npm:@jsr/std__async@^1.1.1",
        "@trussworks/react-uswds": "^9.1.0",
        "isbot": "^4.4.0",
        "mapbox-gl": "^3.18.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router": "^7.13.0",
        "validator": "^13.15.26",
        "vitest": "^2.1.9",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@julr/vite-plugin-validate-env": "^1.3.0",
        "@react-router/dev": "^7.13.0",
        "@types/mapbox-gl": "^3.4.1",
        "@types/postcss-js": "^4.1.0",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@types/validator": "^13.15.10",
        "autoprefixer": "^10.4.24",
        "eslint": "^8.57.1",
        "get-sass-vars": "^4.0.3",
        "postcss": "^8.5.6",
        "postcss-js": "^4.1.0",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^3.2.4",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "sass": "^1.97.3",
        "scss-bundle": "^3.1.2",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "uswds": "^2.14.0",
        "vite": "^6.4.1",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "semi": true,
        "arrowParens": "avoid",
        "plugins": [
            "prettier-plugin-tailwindcss",
            "prettier-plugin-organize-imports"
        ]
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
