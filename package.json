{
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "vite dev --host",
        "format": "prettier -w .",
        "typecheck": "react-router typegen && tsc",
        "test": "node --run test:run",
        "test:dev": "vitest dev",
        "test:run": "vitest run",
        "build": "vite build",
        "start": "react-router-serve ./build/server/index.js",
        "styles:compile-components": "node tailwindcss-uswds/build/compile-components.ts",
        "styles:generate-theme": "node tailwindcss-uswds/build/generate-theme.ts"
    },
    "dependencies": {
        "@deno/kv": "^0.13.0",
        "@react-router/fs-routes": "^8.0.1",
        "@react-router/node": "^8.0.1",
        "@react-router/serve": "^8.0.1",
        "@std/async": "npm:@jsr/std__async@^1.1.1",
        "@trussworks/react-uswds": "^11.0.0",
        "clsx": "^2.1.1",
        "isbot": "^4.4.0",
        "mapbox-gl": "^3.18.1",
        "parse5": "^8.0.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.0",
        "react-router": "^8.0.1",
        "validator": "^13.15.26",
        "vitest": "^4.1.9",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@julr/vite-plugin-validate-env": "^2.2.2",
        "@react-router/dev": "^8.0.1",
        "@types/mapbox-gl": "^3.4.1",
        "@types/postcss-js": "^4.1.0",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "@types/validator": "^13.15.10",
        "@uswds/uswds": "^3.13.0",
        "@xeonlink/prettier-plugin-organize-attributes": "^1.1.0",
        "autoprefixer": "^10.4.24",
        "get-sass-vars": "^4.0.3",
        "postcss": "^8.5.6",
        "postcss-js": "^4.1.0",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^3.2.4",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "sass": "^1.97.3",
        "scss-bundle": "^3.1.2",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^8.0.16",
        "vite-plugin-devtools-json": "^1.0.0"
    },
    "overrides": {
        "vite-plugin-devtools-json": {
            "vite": "$vite"
        }
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "semi": true,
        "arrowParens": "avoid",
        "plugins": [
            "prettier-plugin-tailwindcss",
            "prettier-plugin-organize-imports",
            "@xeonlink/prettier-plugin-organize-attributes"
        ],
        "tailwindConfig": "./tailwind.config.ts",
        "attributeGroups": [
            "^className$",
            "^(id|name|htmlFor)$",
            "$DEFAULT",
            "^aria-"
        ]
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
