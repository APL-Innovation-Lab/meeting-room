{
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "vite dev --host",
        "build": "vite build",
        "start": "react-router-serve ./build/server/index.js",
        "fmt": "oxfmt",
        "lint": "react-router typegen && oxlint --fix",
        "typecheck": "react-router typegen && tsc",
        "test": "vitest run",
        "check": "react-router typegen && oxfmt --check; oxlint; tsc",
        "styles:compile-components": "node tailwindcss-uswds/build/compile-components.ts",
        "styles:generate-theme": "node tailwindcss-uswds/build/generate-theme.ts",
        "skills:update": "skills update"
    },
    "dependencies": {
        "@deno/kv": "^0.14.0",
        "@react-router/node": "^8.0.1",
        "@react-router/serve": "^8.0.1",
        "@trussworks/react-uswds": "^11.0.0",
        "clsx": "^2.1.1",
        "isbot": "^5.1.43",
        "mapbox-gl": "^3.18.1",
        "parse5": "^8.0.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.0",
        "react-router": "^8.0.1",
        "validator": "^13.15.26",
        "vitest": "^4.1.9",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@react-router/dev": "^8.0.1",
        "@types/postcss-js": "^4.1.0",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "@types/validator": "^13.15.10",
        "@uswds/uswds": "3.13.0",
        "autoprefixer": "^10.4.24",
        "eslint-plugin-perfectionist": "^5.9.1",
        "get-sass-vars": "^4.0.3",
        "oxfmt": "^0.55.0",
        "oxlint": "^1.70.0",
        "oxlint-tsgolint": "^0.23.0",
        "postcss": "^8.5.6",
        "postcss-js": "^5.1.0",
        "sass": "^1.97.3",
        "scss-bundle": "^3.1.2",
        "skills": "^1.5.12",
        "tailwindcss": "^3.4.19",
        "typescript": "7.0.1-rc",
        "vite": "^8.0.16",
        "vite-plugin-devtools-json": "^1.0.0"
    },
    "overrides": {
        "scss-bundle": {
            "globs": {
                "glob": "^13.0.0"
            }
        },
        "typescript": "$typescript",
        "vite-plugin-devtools-json": {
            "vite": "$vite"
        }
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
