{
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "vite dev --host",
        "build": "vite build",
        "start": "react-router-serve ./build/server/index.js",
        "fmt": "oxfmt",
        "lint": "react-router typegen && oxlint --fix",
        "typecheck": "react-router typegen && tsc",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "env:check": "varlock load",
        "check": "react-router typegen && oxfmt --check; oxlint; tsc; vitest run",
        "styles:compile-components": "node tailwindcss-uswds/build/compile-components.ts",
        "styles:generate-theme": "node tailwindcss-uswds/build/generate-theme.ts",
        "skills:update": "skills update"
    },
    "dependencies": {
        "@libsql/client": "^0.17.4",
        "@react-router/node": "^8.0.1",
        "@react-router/serve": "^8.0.1",
        "@trussworks/react-uswds": "^11.0.0",
        "clsx": "^2.1.1",
        "drizzle-orm": "^1.0.0-rc.3",
        "isbot": "^5.1.43",
        "mapbox-gl": "^3.18.1",
        "parse5": "^8.0.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.0",
        "react-router": "^8.0.1",
        "validator": "^13.15.26",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@react-router/dev": "^8.0.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/vite": "^4.3.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "@types/validator": "^13.15.10",
        "@uswds/uswds": "3.13.0",
        "@varlock/vite-integration": "^1.2.0",
        "@vitejs/plugin-react": "^6.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "^1.0.0-rc.3",
        "eslint-plugin-perfectionist": "^5.9.1",
        "oxfmt": "^0.55.0",
        "oxlint": "^1.70.0",
        "oxlint-tsgolint": "^0.23.0",
        "postcss": "^8.5.6",
        "sass": "^1.97.3",
        "skills": "^1.5.12",
        "tailwindcss": "^4.3.1",
        "typescript": "7.0.1-rc",
        "varlock": "^1.8.0",
        "vite": "^8.0.16",
        "vite-plugin-devtools-json": "^1.0.0",
        "vitest": "^4.1.9"
